# Env container frontend (Nginx) di Coolify — semua opsional, ini default-nya.
BACKEND_URL=http://backend-tdapku:3000   # alias/nama container aplikasi Next.js di jaringan Coolify
NGINX_PORT=80
CLIENT_MAX_BODY_SIZE=20m                 # samakan dengan serverActions.bodySizeLimit (20mb) di backend

# Pemisahan domain (mode ketat). Kedua host harus terdaftar di Domains aplikasi frontend di Coolify.
# APP_HOST    : host backoffice -> /login, /admin, /account (+ /checkin) dari host lain dialihkan ke sini
# PUBLIC_HOST : host publik     -> halaman publik yang dibuka di APP_HOST dialihkan ke sini
#               (default: APP_HOST tanpa label pertama, mis. app.tdapekanbaru.id -> tdapekanbaru.id)
# Kosongkan APP_HOST untuk menonaktifkan pengalihan.
APP_HOST=app.tdapekanbaru.id
PUBLIC_HOST=tdapekanbaru.id
