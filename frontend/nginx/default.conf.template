# Template ini diproses oleh envsubst (image nginx resmi) saat container start.
# Variabel: ${BACKEND_URL} ${NGINX_PORT} ${CLIENT_MAX_BODY_SIZE} ${NGINX_LOCAL_RESOLVERS}
#           ${APP_HOST} ${BACKOFFICE_REDIRECT_BASE} ${PUBLIC_REDIRECT_BASE} (dari 10-backoffice-host.envsh)
#
# TDA Pekanbaru memakai Next.js SSR: UI dan API dilayani container yang sama, sehingga Nginx
# memproksi SEMUA path (bukan hanya /api) ke ${BACKEND_URL}. Nginx di sini berperan sebagai
# alias jaringan Coolify, penerus header X-Forwarded-*, pembatas ukuran upload, dan /healthz.
#
# proxy_pass memakai VARIABEL + resolver agar nama backend di-resolve saat request (runtime),
# bukan saat Nginx start: container frontend tidak gagal start bila backend belum hidup /
# berganti nama container (Coolify), melainkan membalas 502 sementara dan pulih otomatis.

map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    https   https;
    http    http;
}
map $http_x_forwarded_host $forwarded_host {
    default $host;
    ""      $host;
}
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# Pemisahan domain mode ketat (aktif bila APP_HOST diisi; lihat 10-backoffice-host.envsh):
#  - /login /admin /account dari host selain APP_HOST      -> 302 https://APP_HOST   (cookie sesi host-only)
#  - halaman publik dari APP_HOST                          -> 302 https://PUBLIC_HOST
#  - APP_HOST/ (root)                                      -> 302 /admin
#  - /api/*, /_next/*, /healthz, aset statis, /checkin     -> dilayani di kedua host
map $host $backoffice_base {
    default        "${BACKOFFICE_REDIRECT_BASE}";
    "${APP_HOST}"  "";
}
map $uri $backoffice_path {
    default                              0;
    "~^/(login|admin|account)(/|$)"      1;
}
map $host $public_base {
    default        "";
    "${APP_HOST}"  "${PUBLIC_REDIRECT_BASE}";
}
map $uri $public_path {
    default                                       1;
    "~^/(login|admin|account|checkin)(/|$)"       0;
    "~^/(api|_next)/"                             0;
    "~^/healthz$"                                 0;
    "~\.[A-Za-z0-9]+$"                            0;
}
map "$host$uri" $app_root {
    default          0;
    "${APP_HOST}/"   1;
}

server {
    listen ${NGINX_PORT};
    server_name _;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    resolver_timeout 5s;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # Aset statis Next.js ber-hash -> cache lama di browser.
    location /_next/static/ {
        set $backend_upstream "${BACKEND_URL}";
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $forwarded_host;
        proxy_cache_valid 200 7d;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        proxy_intercept_errors on;
        error_page 502 503 504 = @backend_down;
    }

    # Semua path lain (halaman SSR + /api/*) -> aplikasi Next.js (jaringan internal Coolify)
    location / {
        # Root host backoffice langsung ke dashboard (halaman login menangani bila belum masuk).
        if ($app_root = 1) { return 302 ${BACKOFFICE_REDIRECT_BASE}/admin; }
        # Backoffice hanya di APP_HOST.
        set $backoffice_go "";
        if ($backoffice_path = 1) { set $backoffice_go $backoffice_base; }
        if ($backoffice_go != "") { return 302 $backoffice_go$request_uri; }
        # Halaman publik hanya di PUBLIC_HOST.
        set $public_go "";
        if ($public_path = 1) { set $public_go $public_base; }
        if ($public_go != "") { return 302 $public_go$request_uri; }

        set $backend_upstream "${BACKEND_URL}";
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $forwarded_host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
        proxy_intercept_errors on;
        error_page 502 503 504 = @backend_down;
    }

    location @backend_down {
        default_type application/json;
        return 502 '{"error":"BACKEND_UNAVAILABLE","detail":"Server aplikasi belum dapat dihubungi (backend belum siap atau BACKEND_URL salah). Coba lagi beberapa saat."}';
    }
}
