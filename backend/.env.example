# =============================================================
# TDA Pekanbaru 9.0 — env aplikasi (Coolify: aplikasi "backend", base dir /backend)
# Salin menjadi .env hanya di lokal. JANGAN commit nilai asli.
# Tanda: [WAJIB] harus diisi; [OPSIONAL] ada default.
# =============================================================

# --- Server ---
NODE_ENV=production                 # [OPSIONAL] production|development
PORT=3000                           # [OPSIONAL] port container (Nginx frontend memproksi ke sini)
APP_URL=https://tdapku.my.id        # [WAJIB] origin publik; dipakai redirect login/logout & cek asal form
COOKIE_SECURE=auto                  # [OPSIONAL] auto|true|false — auto ikuti X-Forwarded-Proto dari Nginx/Traefik
TZ=Asia/Jakarta                     # [OPSIONAL] zona waktu proses (DB selalu UTC)

# --- Database MariaDB (Coolify) ---
DATABASE_URL=mysql://mariadb:PASSWORD@nama-service-mariadb:3306/default   # [WAJIB] host internal Coolify
DB_POOL_MAX=10                      # [OPSIONAL] jumlah koneksi pool
SKIP_SCHEMA_SYNC=false              # [OPSIONAL] true = lewati verifikasi skema otomatis saat start

# --- Autentikasi (harus SAMA dengan lingkungan lama agar password 13 akun tetap valid) ---
AUTH_SESSION_SECRET=                # [WAJIB] secret HMAC token sesi (dari /srv/tda-staging/env/auth_session_secret)
AUTH_PASSWORD_PEPPER=               # [WAJIB] pepper hash password scrypt (dari /srv/tda-staging/env/auth_password_pepper)
# Alternatif: AUTH_SESSION_SECRET_FILE / AUTH_PASSWORD_PEPPER_FILE = path file berisi nilai.
AUTH_SESSION_TTL_HOURS=12           # [OPSIONAL] umur sesi login (jam), 1..720

# --- Bootstrap admin (hanya dipakai bila tabel akun login masih KOSONG) ---
BOOTSTRAP_ADMIN_EMAIL=agustrnt@gmail.com   # [OPSIONAL] juga menentukan email Ketua/KSB utama
BOOTSTRAP_ADMIN_PASSWORD=           # [OPSIONAL] minimal 12 karakter; diabaikan bila akun sudah ada
BOOTSTRAP_ADMIN_NAME=Agus Trianto   # [OPSIONAL]

# --- Storage file (bukti bayar, QRIS, flyer, media publik) ---
STORAGE_DRIVER=s3                   # [WAJIB] s3 (Cloudflare R2) | local (dev saja)
R2_ACCOUNT_ID=                      # [WAJIB jika s3] account id Cloudflare (membentuk endpoint)
R2_ENDPOINT=                        # [OPSIONAL] override endpoint, default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=                   # [WAJIB jika s3]
R2_SECRET_ACCESS_KEY=               # [WAJIB jika s3]
R2_BUCKET=media-tdapku              # [WAJIB jika s3]
R2_PREFIX=                          # [OPSIONAL] awalan key objek (kosong = key sama persis dengan data lama)
UPLOAD_PATH=./data/uploads          # [OPSIONAL] hanya untuk STORAGE_DRIVER=local
